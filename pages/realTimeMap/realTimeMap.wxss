.page-section-gap{
  box-sizing: border-box;
  padding: 0 0rpx;
  width: 100%;
  height: 100vh;
  z-index: 0;
  position: fixed;
}

.searchLocationButton {
  border-radius: 45px;
  z-index: 1;
  position: fixed;
  bottom: 70px;
  right: 10px;
  opacity: 0.8;
  font-size: 10px;
}

.searchLocationImage {
  position: fixed;
  bottom: 74px;
  right: 16px;
  width: 36px;
  height: 36px;
  opacity: 0.8;
}

.backToLocationButton {
  border-radius: 45px;
  z-index: 1;
  position: fixed;
  bottom: 15px;
  right: 10px;
  opacity: 0.8;
  font-size: 10px;
}

.backToLocationImage {
  position: fixed;
  bottom: 15px;
  right: 13px;
  width: 42px;
  height: 42px;
  opacity: 0.8;
}

.showmes{
  background: rgb(255, 255, 255);
  height: 25%;
  border-radius: 40rpx;  
  margin-left: 5%;
  margin-right: 5%;  
  opacity: 0.8;
  overflow: hidden;
  position: fixed;
  bottom:1.5%;  
  width: 90%;
}

.out{  
  margin-top:2%;
  margin-left: 89%;
  width: 45rpx;
  height:45rpx;
  display: inline-block;
  overflow: hidden;
  position: absolute;  
}

.loc_name{
  margin-top:5.5%;
  text-align: center;
  font-size:x-large;    
}

.dis{
  text-align: center;
  font-size:large;
