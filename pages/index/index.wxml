<!--pages/test/test.wxml-->
<!-- 疫情小贴士 -->
<view class="box1">
  <view class="tipbox">
  <view class="text" style="{{orientation}}:{{marqueeDistance2}}px;font-size:{{size}}px;">
    <text>{{text}}</text>
    <text wx:if="{{marquee2copy_status}}" style="margin-left:{{marquee2_margin}}px;">{{text}}</text>
  </view>
</view>
</view>

<!-- 海报 -->
<view class="post">
  <image wx:if='{{picurl}}' src="{{picurl}}images/poster.png" style="width:100%;height:350rpx;"></image>
</view>
<!-- 新闻 -->
<view class="outer">
  <view class="box2">
    <!-- 位置信息 -->
  <view class="location">
    <view class="icon">
      <image src="https://i.ibb.co/vvvNDnh/image.png" style="width:45rpx;height:45rpx" mode="aspectFit"></image>

    </view>
    <view class="text">{{locationList.country}} {{locationList.province}} {{locationList.city}} {{locationList.district}} {{locationList.street}}</view>
  </view>
  <!-- 疑似地点 -->
  <view class="place">
    <view class="txtleft">
      <view class="text">实时预测</view>
      <view class="line"></view>
    </view>
    <view class="txtright">
      <navigator class="tip1" url="../../pages/loc_prediction/loc_prediction">点击进入</navigator>
    </view>
  </view>
  <!-- 疑似地点内容 -->
  <view class="tip">
  <!-- 将为您提供全国实时的疑似地点和确诊概率的预测分析 -->
  <image wx:if='{{picurl}}' src="{{picurl}}images/wordcloud.png" style="width:100%;height:350rpx;" mode="aspectFit"></image>
  </view>
  <!-- 推荐&查看全部 -->
  <view class="recommendbox">
    <view class="txtleft">
      <view class="text">新闻速报</view>
      <view class="line"></view>
    </view>
    <view class="txtright">
      <navigator url="../../allNewList/pages/newList/newsList"> 查看全部</navigator>
    </view>
  </view>
  <!-- 新闻框 -->
  <view class="newbox" wx:for="{{newsList}}" wx:key="index">
    <!-- 发布人信息+时间 -->
    <view class="header">
      <!-- 头像 -->
      <view class="idpic">
        <image src="{{item.profileUrl}}" style="height:100rpx;width:100rpx;border-radius:50%;border: 1px solid gray;" ></image>
      </view>
      <!-- 名字+时间 -->
      <view class="idinfo">
        <view class="idname">{{item.screenName}}</view>
        <view class="time">
          <view>{{item.createdAt}}</view>
        </view>
      </view>

    </view>
    <!-- 新闻主题 -->
    <view class="body">
      <!-- 内容 -->
      <view class='content {{item.status ? "hidden" : ""}}'>{{item.text}}</view>
      <view class='readmore-tip' bindtap='toggle' data-index='{{index}}'>{{item.tip}}</view>
      <!-- <view class="text">{{item.text}}</view> -->
      <view class="link" wx:if="{{item.pics}}" wx:for="{{item.pics}}" wx:for-item="pics" wx:key="index">
        <image src=" {{pics}}" style="height: 300rpx;width: 500rpx;" mode="widthFix">
        </image>
      </view>
      <!-- <view class="link" wx:else="{{item.VideoUrl}}">
        <video src="{{item.videoUrl}}" style="height: 300rpx;width: 500rpx;" binderror="videoErrorCallback"></video>
      </view> -->
    </view>
    <!-- 分割线 -->
    <!-- <view class="divideLine"></view> -->
  </view>

  </view>
</view>
