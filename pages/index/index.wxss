/* pages/test/test.wxss */
.page{
  width:100%;
  height:100%;
}
.box1{
  background:#516391;
  border-bottom: white 2rpx;
}
.box1 .tipbox {
  width: 680rpx;
  height: 70rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 46rpx;
  color: #fff;
  font-size: 28rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
  position: relative;
  display: flex;
  align-items: center;
  text-indent: 10rpx;
  overflow: hidden;
}

.box1 .tipbox .text {
  white-space: nowrap;
  position: absolute;
  top: 0;
}
.post{
  width: 100%;
  height: 200rpx;
}
.outer{
  position: relative;
  background-color: white;
  border-radius: 45rpx 45rpx;
  margin-top: 115rpx;
  width:100%;
  display: flex;

}
.outer .box2{
  position: relative;
  margin-top: 30rpx;
  margin-left: 30rpx;
  width:95%;
  display: flex;
  flex-direction: column;
}
.outer .box2 .location{
  display: flex;
  flex-direction: row;
  margin-left: 30rpx;
  font-size: 28rpx;
  color: gray;
  align-items: center;
  
}
.outer .box2 .location .text{
  margin-left: 10rpx;
}
.outer .box2 .place{
  display: flex;
  flex-direction: row;
  align-items: center;
  height:80rpx;
  width:95%;
  margin-bottom: 20rpx;
  /* background-color: rgba(245, 231, 190, 0.562); */
  
  font-size: medium;
  border-radius: 20rpx;
}
.outer .box2 .place .txtleft{
  margin-left: 20rpx;
  /* background-color: #a10000;
  border-radius: 20rpx; */
  /* color: white; */
  width:200rpx;
  border-bottom: #a10000 10rpx;
  display: flex;
  flex-direction: column;
}
.outer .box2 .place .txtleft .text{
  font-weight:800 ;
  font-size: x-large;
}
.outer .box2 .place .txtleft .line{
  width:200rpx;
  height: 15rpx;
  margin-top: -10rpx;
  margin-left: 15rpx;
  background-color: #a10000bd;
}
.outer .box2 .place .txtright .tip1{
  font-size: 28rpx;
  margin-left: 330rpx;
  color: gray;
  margin-top: 10rpx;
}
.outer .box2 .tip{
  font-size: 30rpx;
  margin-left: 50rpx;
  margin-bottom: 10rpx;
  width: 85%;
}
.outer .box2 .recommendbox{
  display: flex;
  flex-direction: row;
  align-items: center;
  height:80rpx;
  width:95%;
  /* background-color: rgba(245, 231, 190, 0.562); */
  
  font-size: medium;
  border-radius: 20rpx;
}
.outer .box2 .recommendbox .txtleft{
  margin-left: 20rpx;
  /* background-color: #a10000;
  border-radius: 20rpx; */
  /* color: white; */
  width:200rpx;
  border-bottom: #a10000 10rpx;
  display: flex;
  flex-direction: column;
}
.outer .box2 .recommendbox .txtleft .text{
  font-weight:800 ;
  font-size: x-large;
}
.outer .box2 .recommendbox .txtleft .line{
  width:200rpx;
  height: 15rpx;
  margin-top: -10rpx;
  margin-left: 15rpx;
  background-color: #a10000bd;
}
.outer .box2 .recommendbox .txtright{
  font-size: 28rpx;
  margin-left: 330rpx;
  color: gray;
}
 
.outer .box2 .newbox{
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  border-bottom:rgba(231, 228, 228, 0.582) solid 5rpx;
  /* background-color: rgba(231, 228, 228, 0.452); */
  width: 95%;
  margin-left: 10rpx;

}
.outer .box2 .newbox .header{
  display: flex;
  flex-direction: row;
  height:100rpx;
  margin-top: 20rpx;
  
}
/* .box2 .newbox .header .idpic{ 

} */
.outer .box2 .newbox .header .idinfo{
  height:70rpx;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.outer .box2 .newbox .header .idinfo .idname{
  height:30rpx;
  margin-top: 10rpx;
}
.outer .box2 .newbox .header .idinfo .time{
  height:30rpx;
  margin-top: 20rpx;
  font-size: small;
  color:gray;
}
.outer .box2 .newbox .body{
  margin-top:20rpx;
  margin-bottom: 20rpx;
  width: 98%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 超出5行隐藏多余部分并且显示省略号 */
.outer .box2 .newbox .body .hidden{
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp:5;
  -webkit-box-orient: vertical;
}
.outer .box2 .newbox .body .readmore-tip {
  color: #196a99;
  font-size: 24rpx;
  margin-top: 30rpx;
}
.outer .box2 .newbox .body .content{
  font-size: 24rpx;
  line-height: 1.5em;
  margin-left: 10rpx;
}
.outer .box2 .newbox .body .link{
  margin-top: 20rpx;
} 
