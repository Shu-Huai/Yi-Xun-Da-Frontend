/* pages/loc_prediction/loc_prediction.wxss */
.toptitle{
  height: 10rpx;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}
.place{
  margin-top: 50rpx;
  height:320rpx;
  width: 95%;
  display: flex;
  flex-direction: column;
  /* align-items: center; */
  /* justify-content: center; */
  margin-left: 15rpx;
  border-style: solid;
  box-shadow:0px 2px 4px 2px #DDDDDD;
  border-width: 0rpx;
  /* margin-bottom: 20rpx; */
}
.place .locPrediction{
  height: 80rpx;
  display: flex;
  flex-direction: row;
  font-size: 40rpx;
  margin-left: 20rpx;
  margin-top: 10rpx;
}
.place .locPrediction .title{
  padding-right: 20rpx;
}
.place .locPrediction .detail{
  font-size: x-large;
  /* color:#a10000; */
  font-weight: 650;
  letter-spacing: 5rpx;
}
.place .rate{
  display: flex;
  flex-direction: row;
  font-size: 30rpx;
  /* margin-left: 20rpx; */
  margin-bottom: 5rpx;
  margin-top: 10rpx;
  justify-content: center;
  align-items: center;
}
.place .rate .box{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-style: solid;
  box-shadow:0px 0px 2px 0px #DDDDDD;
  border-width: 0rpx;
  width:45%;
  
}
.place .rate .box .num{
  font-size: xx-large;
  color:#f7c25f;
  font-weight: 600;
}
.place .rate .box .name{
  font-size: small;
  margin-bottom: 15rpx;
  color:rgb(131, 128, 128);
}
.place .news{
  display: flex;
  margin-left: 30rpx;
  margin-top: 8rpx;
  margin-bottom: 5rpx;
}
.place .news .text{
  margin-left: 20rpx;
  margin-top: 15rpx;
  color:#a10000d2;
  font-weight: 600;
  font-size: 30rpx;
}